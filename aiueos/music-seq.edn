;; app-music — itonami（dapp）の aiueos アプリ記述子（notes.edn 形）。
;; 判定コアは aiueos/music_seq.cljk（sortable-artist / sequence-key / capability 分割）。
;; 正本は src/app_music/model.cljk。pure（:effects #{}）。
{:aiueos/component :app/music-seq
 :aiueos/kind :app
 :aiueos/trust :untrusted
 :aiueos/source "music_seq.cljk"
 :aiueos/wasm "music_seq.wasm"
 :aiueos/entry "main"
 :aiueos/args []
 :aiueos/imports #{}
 :aiueos/exports #{:app/main
                   :app/sequence-key
                   :app/artist-code
                   :app/grant-judgment
                   :app/id-is-path}
 :aiueos/effects #{}
 :aiueos/limits {:memory-pages 16 :fuel 5000000}}
